
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreenLeaf Grocers - Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7f4;
            color: #26352a;
        }

        header {
            background: #176b3a;
            color: white;
            padding: 22px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        header h1 {
            font-size: 25px;
        }

        header p {
            margin-top: 6px;
        }

        .logout {
            background: white;
            color: #176b3a;
            padding: 10px 18px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
        }

        .container {
            width: 92%;
            max-width: 1200px;
            margin: 30px auto;
        }

        .welcome {
            margin-bottom: 25px;
        }

        .welcome h2 {
            color: #176b3a;
            margin-bottom: 10px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 25px 0;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.07);
            border-left: 5px solid #176b3a;
        }

        .card h3 {
            color: #66756a;
            font-size: 15px;
            margin-bottom: 12px;
        }

        .card h2 {
            color: #176b3a;
            font-size: 28px;
        }

        .section {
            background: white;
            padding: 25px;
            margin-top: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        }

        .section h2 {
            color: #176b3a;
            margin-bottom: 18px;
        }

        .menu {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 15px;
        }

        .menu a {
            display: block;
            padding: 18px;
            background: #edf7ef;
            color: #176b3a;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            border: 1px solid #d5e9d9;
            transition: 0.2s;
        }

        .menu a:hover {
            background: #176b3a;
            color: white;
            transform: translateY(-3px);
        }

        ul {
            padding-left: 22px;
            line-height: 1.9;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th,
        td {
            padding: 13px;
            border-bottom: 1px solid #e5e5e5;
            text-align: left;
        }

        th {
            background: #176b3a;
            color: white;
        }

        tr:hover {
            background: #f4faf5;
        }

        .empty {
            color: #777;
            padding: 15px 0;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #777;
        }

        @media(max-width: 600px) {
            header {
                align-items: flex-start;
                flex-direction: column;
            }

            .container {
                width: 95%;
            }

            .section {
                padding: 17px;
                overflow-x: auto;
            }
        }
    </style>
</head>

<body>

    <header>
        <div>
            <h1>🌿 GreenLeaf Grocers</h1>
            <p>Inventory & Sales Management System</p>
        </div>

        <a href="{{ url_for('logout') }}" class="logout">Logout</a>
    </header>

    <div class="container">

        <div class="welcome">
            <h2>Welcome to GreenLeaf Grocers!</h2>

            <p>Logged in as: <strong>{{ session.get('username', 'User') }}</strong></p>
            <p>Role: <strong>{{ session.get('role', 'User') }}</strong></p>
        </div>

        <!-- Dashboard Statistics -->

        <div class="section">
            <h2>📊 Dashboard Information</h2>

            <div class="cards">

                <div class="card">
                    <h3>Total Sales</h3>
                    <h2>{{ total_sales }}</h2>
                </div>

                <div class="card">
                    <h3>Total Revenue</h3>
                    <h2>₹{{ "%.2f"|format(total_revenue) }}</h2>
                </div>

                <div class="card">
                    <h3>Total Products</h3>
                    <h2>{{ total_products }}</h2>
                </div>

                <div class="card">
                    <h3>Low Stock Products</h3>
                    <h2>{{ low_stock }}</h2>
                </div>

            </div>
        </div>

        <!-- Main Navigation -->

        <div class="section">
            <h2>🚀 Management & Navigation</h2>

            <div class="menu">

                <a href="{{ url_for('billing') }}">
                    🛒 Billing System
                </a>

                <a href="{{ url_for('products') }}">
                    📦 Product Management
                </a>

                <a href="{{ url_for('reports') }}">
                    📊 Reports & Analytics
                </a>

                {% if session.get('role') == 'admin' %}
                <a href="{{ url_for('analytics_dashboard') }}">
                    📈 Advanced Analytics Dashboard
                </a>
                {% endif %}

                <a href="{{ url_for('alerts') }}">
                    ⚠️ Stock & Expiry Alerts
                </a>

                {% if session.get('role') == 'admin' %}

                <a href="{{ url_for('import_products') }}">
                    📥 Import Products (CSV)
                </a>

                <a href="{{ url_for('export_products') }}">
                    📤 Export Products (CSV)
                </a>

                <a href="{{ url_for('export_sales') }}">
                    📄 Export Sales Report
                </a>

                {% endif %}

            </div>
        </div>

        <!-- Billing Information -->

        <div class="section">
            <h2>🧾 Billing Information</h2>

            <ul>
                <li>Select products from inventory.</li>
                <li>Enter product quantities.</li>
                <li>Calculate subtotal automatically.</li>
                <li>Apply customer discounts.</li>
                <li>Calculate final bill amount.</li>
                <li>Generate customer bills and receipts.</li>
                <li>Automatically update stock after billing.</li>
            </ul>
        </div>

        <!-- Recent Sales -->

        <div class="section">
            <h2>📈 Recent Sales Information</h2>

            {% if recent_sales %}

            <table>
                <thead>
                    <tr>
                        <th>Bill ID</th>
                        <th>Date</th>
                        <th>Total Amount</th>
                        <th>Time</th>
                    </tr>
                </thead>

                <tbody>
                    {% for sale in recent_sales %}
                    <tr>
                        <td>{{ sale.sale_id }}</td>
                        <td>{{ sale.sale_date }}</td>
                        <td>₹{{ "%.2f"|format(sale.total_amount) }}</td>
                        <td>{{ sale.sale_time }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% else %}

            <p class="empty">No sales records available.</p>

            {% endif %}
        </div>

    </div>

    <footer>
        <p>© 2026 GreenLeaf Grocers | Inventory & Sales Management System</p>
    </footer>

</body>

</html>
